# Copy to .env and fill in; .env is not committed and not sent to the Docker build.
# A value can be generated with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"

# Password of the studio sign-in form, at least 12 characters
STUDIO_PASSWORD=
# Key the scoring API expects in the X-API-Key header, at least 32 characters
API_KEY=

# --- Optional (defaults shown) ------------------------------------------------------
# Largest uploaded file or API request body, megabytes
# MAX_UPLOAD_MB=20
# Largest training table and scoring batch, rows (MAX_SCORE_ROWS cannot exceed 10000)
# MAX_TRAIN_ROWS=200000
# MAX_SCORE_ROWS=10000
# LOG_LEVEL=INFO

# Release gate: how much worse than its evaluation model a production model may be
# on test (C-index, IBS), and absolute limits for calibration and the backtest.
# Decide these before training; do not adjust them to let a model through.
# GATE_C_INDEX_TOLERANCE=0.01
# GATE_IBS_TOLERANCE=0.005
# GATE_MAX_CALIBRATION_ERROR=0.05
# GATE_MIN_BACKTEST_GROUPS=4
